
VLOGAN	= vlogan
VLOGAN_OPT	= -full64 -sverilog +v2k -timescale=1ns/1ps -full64

all :		_VCSgd_ElmsJd_1.db \
	_VCSgd_jBAPse_1.db \
	_VCSgd_QTXXtc_1.db \
	_VCSgd_518uhe_1.db \
	_VCSgd_eThKre_1.db \
	_VCSgd_KxnGYb_1.db \



