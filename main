#!/usr/bin/make -f
# ============================================================
# Makefile — NebuCore AXI Interconnect Testbenches / Secure-IoT-Gateway-SoC
# Simulator: Synopsys VCS  (U-2023.03)
#
# Targets:
#   make -f main sim_1x8       — compile + run 1-master / 8-slave TB
#   make -f main sim_2x8       — compile + run 2-master / 8-slave TB
#   make -f main sim_3x15      — compile + run 3-master / 15-slave TB
#   make -f main sim_soc       — compile + run full SoC TB (RISC-V + IC + Peripherals)
#   make -f main sim_pwm       — compile + run standalone PWM TB
#   make -f main sim_firmware  — build firmware + run SoC simulation
#   make -f main sim_uart_pwm  — build UART->PWM test + run SoC sim with full FSDB dump
#   make -f main verdi         — open soc_top.fsdb in Verdi using verdi_config_file
#   make -f main waves_1x8     — open 1x8 VCD in GTKWave
#   make -f main waves_2x8     — open 2x8 VCD in GTKWave
#   make -f main waves_soc     — open soc_top.fsdb in Verdi / GTKWave
#   make -f main waves_pwm     — open tb_pwm_top.vcd in GTKWave
#   make -f main clean         — remove all generated artefacts
#
# NOTE: The Synopsys license server must be running.
#       If you see "Vendor daemon is down" start it with:
#         cd /home/install/LMGR && ./lmgrd -c license.lic
# ============================================================

VCS_HOME             := /home/student/snps_tools_target/vcs/U-2023.03
VCS                  := $(VCS_HOME)/linux64/bin/vcs
VERDI_HOME           := /home/student/snps_tools_target/verdi/U-2023.03-SP1
VERDI                := $(VERDI_HOME)/bin/verdi
NOVAS_TAB            := $(VERDI_HOME)/share/PLI/VCS/linux64/novas.tab
NOVAS_PLI            := $(VERDI_HOME)/share/PLI/VCS/linux64/pli.a
SNPSLMD_LICENSE_FILE := 27020@14.139.1.126:27021@14.139.1.126:27000@14.139.1.126
LM_LICENSE_FILE      := $(SNPSLMD_LICENSE_FILE)

export VCS_HOME
export VERDI_HOME
export SNPSLMD_LICENSE_FILE
export LM_LICENSE_FILE

# ── Common RTL ───────────────────────────────────────────
RTL_COMMON := \
    rtl/priority_encoder.v \
    rtl/arbiter.v \
    rtl/axi_interconnect.v

VCS_OPTS := \
    -full64 \
    -sverilog \
    +v2k \
    -timescale=1ns/1ps \
    -debug_access+all

# ════════════════════════════════════════════════════════
# 1x8 target
# ════════════════════════════════════════════════════════
SRCS_1X8 := \
    $(RTL_COMMON) \
    run/axi_interconnect_wrap_1x8.v \
    tb/axi_slave_stub.v \
    tb/tb_axi_interconnect.v

SIM_1X8  := simv_1x8
TOP_1X8  := tb_axi_interconnect
VCD_1X8  := tb_axi_interconnect.vcd

sim_1x8: $(SIM_1X8)
	@echo ">>> Running 1x8 simulation..."
	./$(SIM_1X8) -l sim_1x8.log
	@echo ">>> Done. Log: sim_1x8.log"

$(SIM_1X8): $(SRCS_1X8)
	@echo ">>> Compiling 1x8 TB..."
	$(VCS) $(VCS_OPTS) -top $(TOP_1X8) $(SRCS_1X8) -o $(SIM_1X8) -l compile_1x8.log
	@echo ">>> Compilation done."

waves_1x8:
	@command -v gtkwave >/dev/null 2>&1 \
	    && gtkwave $(VCD_1X8) & \
	    || echo "GTKWave not found — open $(VCD_1X8) manually."

# ════════════════════════════════════════════════════════
# 2x8 target
# ════════════════════════════════════════════════════════
SRCS_2X8 := \
    $(RTL_COMMON) \
    run/axi_interconnect_wrap_2x8.v \
    tb/axi_slave_stub.v \
    tb/tb_axi_interconnect_2x8.v

SIM_2X8  := simv_2x8
TOP_2X8  := tb_axi_interconnect_2x8
VCD_2X8  := tb_axi_interconnect_2x8.vcd

sim_2x8: $(SIM_2X8)
	@echo ">>> Running 2x8 simulation..."
	./$(SIM_2X8) -l sim_2x8.log
	@echo ">>> Done. Log: sim_2x8.log"

$(SIM_2X8): $(SRCS_2X8)
	@echo ">>> Compiling 2x8 TB..."
	$(VCS) $(VCS_OPTS) -top $(TOP_2X8) $(SRCS_2X8) -o $(SIM_2X8) -l compile_2x8.log
	@echo ">>> Compilation done."

waves_2x8:
	@command -v gtkwave >/dev/null 2>&1 \
	    && gtkwave $(VCD_2X8) & \
	    || echo "GTKWave not found — open $(VCD_2X8) manually."

# ════════════════════════════════════════════════════════
# 3x15 target  (AXI interconnect with real UART IP on M00)
# ════════════════════════════════════════════════════════
UART_RTL := \
    rtl/uart/src/rtl/axi_uart_top.v \
    rtl/uart/src/rtl/uart_controller.v \
    rtl/uart/src/rtl/uart_transmitter.v \
    rtl/uart/src/rtl/uart_receiver.v \
    rtl/uart/src/rtl/uart_parity_bit_compute.v \
    rtl/uart/src/rtl/axi_internal_fifo.v

VCS_OPTS_3X15 := \
    -full64 \
    -sverilog \
    +v2k \
    -timescale=1ns/1ps \
    -debug_access+all \
    +incdir+rtl/uart/src/include

SRCS_3X15 := \
    $(RTL_COMMON) \
    rtl/axi_interconnect_wrap_3x15.v \
    $(UART_RTL) \
    rtl/tb_axi_interconnect_3x15.sv

SIM_3X15  := simv_3x15
TOP_3X15  := tb_axi_interconnect_3x15

sim_3x15: $(SIM_3X15)
	@echo ">>> Running 3x15 simulation..."
	./$(SIM_3X15) -l sim_3x15.log
	@echo ">>> Done. Log: sim_3x15.log"

$(SIM_3X15): $(SRCS_3X15)
	@echo ">>> Compiling 3x15 TB (with UART IP on M00)..."
	$(VCS) $(VCS_OPTS_3X15) -top $(TOP_3X15) $(SRCS_3X15) -o $(SIM_3X15) -l compile_3x15.log
	@echo ">>> Compilation done."

# ════════════════════════════════════════════════════════
# soc_top target  (RISC-V VeeR EL2 + AXI Interconnect + all peripherals)
# ════════════════════════════════════════════════════════
RISCV_DESIGN := rtl/riscv/design

RISCV_RTL := \
    $(RISCV_DESIGN)/include/el2_def.sv \
    $(RISCV_DESIGN)/lib/el2_assert.sv \
    $(RISCV_DESIGN)/el2_mubi_pkg.sv \
    $(RISCV_DESIGN)/el2_mem.sv \
    $(RISCV_DESIGN)/el2_dma_ctrl.sv \
    $(RISCV_DESIGN)/el2_pic_ctrl.sv \
    $(RISCV_DESIGN)/el2_pmp.sv \
    $(RISCV_DESIGN)/dbg/el2_dbg.sv \
    $(RISCV_DESIGN)/dmi/dmi_wrapper.v \
    $(RISCV_DESIGN)/dmi/dmi_jtag_to_core_sync.v \
    $(RISCV_DESIGN)/dmi/dmi_mux.v \
    $(RISCV_DESIGN)/dmi/rvjtag_tap.v \
    $(RISCV_DESIGN)/lib/beh_lib.sv \
    $(RISCV_DESIGN)/lib/mem_lib.sv \
    $(RISCV_DESIGN)/lib/el2_lib.sv \
    $(RISCV_DESIGN)/lib/el2_mem_if.sv \
    $(RISCV_DESIGN)/lib/el2_regfile_if.sv \
    $(RISCV_DESIGN)/lib/el2_prim_buf.sv \
    $(RISCV_DESIGN)/lib/el2_prim_generic_buf.sv \
    $(RISCV_DESIGN)/lib/axi4_to_ahb.sv \
    $(RISCV_DESIGN)/lib/ahb_to_axi4.sv \
    $(RISCV_DESIGN)/dec/el2_dec.sv \
    $(RISCV_DESIGN)/dec/el2_dec_decode_ctl.sv \
    $(RISCV_DESIGN)/dec/el2_dec_tlu_ctl.sv \
    $(RISCV_DESIGN)/dec/el2_dec_ib_ctl.sv \
    $(RISCV_DESIGN)/dec/el2_dec_gpr_ctl.sv \
    $(RISCV_DESIGN)/dec/el2_dec_pmp_ctl.sv \
    $(RISCV_DESIGN)/dec/el2_dec_trigger.sv \
    $(RISCV_DESIGN)/exu/el2_exu.sv \
    $(RISCV_DESIGN)/exu/el2_exu_alu_ctl.sv \
    $(RISCV_DESIGN)/exu/el2_exu_mul_ctl.sv \
    $(RISCV_DESIGN)/exu/el2_exu_div_ctl.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_bus_buffer.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_bus_intf.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_dccm_ctl.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_dccm_mem.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_ecc.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_lsc_ctl.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_stbuf.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_trigger.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_clkdomain.sv \
    $(RISCV_DESIGN)/lsu/el2_lsu_addrcheck.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_mem_ctl.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_ifc_ctl.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_aln_ctl.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_bp_ctl.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_compress_ctl.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_ic_mem.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_iccm_mem.sv \
    $(RISCV_DESIGN)/ifu/el2_ifu_tb_memread.sv \
    $(RISCV_DESIGN)/el2_veer.sv \
    $(RISCV_DESIGN)/el2_veer_wrapper.sv

# All peripheral RTL (UART, Timer, GPIO, PWM, Seg7, WDT)
PERIPH_RTL := \
    rtl/uart/src/rtl/axi_uart_top.v \
    rtl/uart/src/rtl/uart_controller.v \
    rtl/uart/src/rtl/uart_transmitter.v \
    rtl/uart/src/rtl/uart_receiver.v \
    rtl/uart/src/rtl/uart_parity_bit_compute.v \
    rtl/uart/src/rtl/axi_internal_fifo.v \
    rtl/timer/src/rtl/axi_timer_top.v \
    rtl/gpio/src/rtl/axi_gpio_top.v \
    rtl/pwm/src/rtl/axi_pwm_top.v \
    rtl/seg7/src/rtl/axi_seg7_top.v \
    rtl/wdt/src/rtl/axi_wdt_top.v

VCS_OPTS_SOC := \
    -full64 \
    -sverilog \
    +v2k \
    -timescale=1ns/1ps \
    -debug_access+all \
    +define+RV_BUILD_AXI4 \
    +incdir+$(RISCV_DESIGN)/include \
    +incdir+snapshots/default \
    +incdir+rtl/uart/src/include \
    +incdir+rtl/pwm/src/include \
    +incdir+rtl/timer/src/include \
    +incdir+rtl/gpio/src/include \
    +incdir+rtl/seg7/src/include \
    +incdir+rtl/wdt/src/include

SRCS_SOC := \
    $(RTL_COMMON) \
    rtl/axi_interconnect_wrap_3x15.v \
    rtl/axi_width_adapter.sv \
    $(PERIPH_RTL) \
    $(RISCV_RTL) \
    rtl/soc_top.sv \
    rtl/tb_soc_top.sv

SIM_SOC  := simv_soc
TOP_SOC  := tb_soc_top

sim_soc: $(SIM_SOC)
	@echo ">>> Running SoC simulation (RISC-V + AXI 3x15 + UART/Timer/GPIO/PWM/Seg7/WDT)..."
	./$(SIM_SOC) -l sim_soc.log
	@echo ">>> Done. Log: sim_soc.log"

$(SIM_SOC): $(SRCS_SOC)
	@echo ">>> Compiling SoC TB (RISC-V VeeR EL2 + AXI 3x15 + all peripherals)..."
	$(VCS) $(VCS_OPTS_SOC) -top $(TOP_SOC) $(SRCS_SOC) -o $(SIM_SOC) -l compile_soc.log
	@echo ">>> Compilation done. Log: compile_soc.log"

waves_soc:
	@command -v gtkwave >/dev/null 2>&1 \
	    && gtkwave soc_top.fsdb & \
	    || echo "Use Verdi/DVE to open soc_top.fsdb"

# ════════════════════════════════════════════════════════
# Firmware build + SoC simulation with C test program
# ════════════════════════════════════════════════════════
RISCV_TOOLCHAIN ?= /opt/riscv/bin
RISCV_GCC       := $(RISCV_TOOLCHAIN)/riscv64-unknown-elf-gcc
RISCV_OBJCOPY   := $(RISCV_TOOLCHAIN)/riscv64-unknown-elf-objcopy
RISCV_OBJDUMP   := $(RISCV_TOOLCHAIN)/riscv64-unknown-elf-objdump

FW_DIR      := firmware
FW_SRC      := $(FW_DIR)/nebulizer_test.c
FW_LD       := $(FW_DIR)/nebulizer.ld
FW_HEX_GEN  := $(FW_DIR)/elf_to_hex.py
FW_ELF      := $(FW_DIR)/nebulizer_test.elf
FW_HEX      := $(FW_DIR)/nebulizer_test.hex
FW_BIN      := $(FW_DIR)/nebulizer_test.bin
FW_LST      := $(FW_DIR)/nebulizer_test.lst

FW_CFLAGS  := -march=rv32imc_zicsr -mabi=ilp32 -Os -Wall -Wextra \
              -ffreestanding -nostdlib -nostartfiles \
              -fno-builtin -fno-common -fno-builtin-memcpy -fno-builtin-memset \
              -Wl,--gc-sections -Wl,--build-id=none
FW_LDFLAGS := -T $(FW_LD) -nostdlib -nostartfiles -Wl,--gc-sections

VCS_OPTS_FW := \
    -full64 \
    -sverilog \
    +v2k \
    -timescale=1ns/1ps \
    -debug_access+all \
    +define+RV_BUILD_AXI4 \
    +define+FW_HEX_FILE \
    +incdir+$(RISCV_DESIGN)/include \
    +incdir+snapshots/default \
    +incdir+rtl/uart/src/include \
    +incdir+rtl/pwm/src/include \
    +incdir+rtl/timer/src/include \
    +incdir+rtl/gpio/src/include \
    +incdir+rtl/seg7/src/include \
    +incdir+rtl/wdt/src/include

SIM_FW   := simv_firmware
TOP_FW   := tb_soc_top

firmware: $(FW_HEX)

FW_OBJ := firmware/nebulizer_test.o

$(FW_OBJ): $(FW_SRC)
	@echo ">>> Compiling firmware (RV32IMC)..."
	$(RISCV_GCC) $(FW_CFLAGS) -c -o $@ $(FW_SRC)
	@echo ">>> Object: $@"

$(FW_ELF): $(FW_OBJ) $(FW_LD)
	@echo ">>> Linking firmware..."
	$(RISCV_GCC) $(FW_CFLAGS) -T $(FW_LD) -nostdlib -nostartfiles \
	    -Wl,--gc-sections \
	    -o $@ $(FW_OBJ)
	@echo ">>> Firmware ELF: $@"
	$(RISCV_OBJDUMP) -d $@ > $(FW_LST)
	@echo ">>> Disassembly:  $(FW_LST)"

$(FW_BIN): $(FW_ELF)
	$(RISCV_OBJCOPY) -O binary $< $@

$(FW_HEX): $(FW_ELF) $(FW_HEX_GEN)
	@echo ">>> Generating hex file for readmemh..."
	python3 $(FW_HEX_GEN) $(FW_ELF) $(FW_HEX) --word-size 8
	@echo ">>> Hex file:     $(FW_HEX)"

sim_firmware: $(FW_HEX) $(SIM_FW)
	@echo ">>> Running SoC simulation with firmware..."
	./$(SIM_FW) -l sim_firmware.log
	@echo ">>> Done. Log: sim_firmware.log"

$(SIM_FW): $(SRCS_SOC) $(FW_HEX)
	@echo ">>> Compiling SoC TB with firmware hex..."
	$(VCS) $(VCS_OPTS_FW) -top $(TOP_FW) $(SRCS_SOC) -o $(SIM_FW) -l compile_firmware.log
	@echo ">>> Compilation done. Log: compile_firmware.log"

waves_firmware:
	@command -v gtkwave >/dev/null 2>&1 \
	    && gtkwave soc_top.fsdb & \
	    || echo "Use Verdi/DVE to open soc_top.fsdb"

# ════════════════════════════════════════════════════════
# sim_uart_pwm target — C Test: UART RX -> Computations -> PWM Generator with Verdi FSDB
# ════════════════════════════════════════════════════════
FW_UART_PWM_SRC := $(FW_DIR)/uart_to_pwm_test.c
FW_UART_PWM_ELF := $(FW_DIR)/uart_to_pwm_test.elf
FW_UART_PWM_HEX := $(FW_DIR)/uart_to_pwm_test.hex
FW_UART_PWM_LST := $(FW_DIR)/uart_to_pwm_test.lst

VCS_OPTS_UART_PWM := \
    -full64 \
    -sverilog \
    +v2k \
    -timescale=1ns/1ps \
    -debug_access+all \
    -kdb \
    -P $(NOVAS_TAB) $(NOVAS_PLI) \
    +define+RV_BUILD_AXI4 \
    +define+FW_HEX_FILE \
    +define+FSDB \
    +define+TB_UART_INJECT \
    +incdir+$(RISCV_DESIGN)/include \
    +incdir+snapshots/default \
    +incdir+rtl/uart/src/include \
    +incdir+rtl/pwm/src/include \
    +incdir+rtl/timer/src/include \
    +incdir+rtl/gpio/src/include \
    +incdir+rtl/seg7/src/include \
    +incdir+rtl/wdt/src/include

SIM_UART_PWM := simv_uart_pwm

$(FW_UART_PWM_ELF): $(FW_UART_PWM_SRC) $(FW_LD)
	@echo ">>> Compiling and linking UART to PWM firmware..."
	$(RISCV_GCC) $(FW_CFLAGS) -T $(FW_LD) -nostdlib -nostartfiles -Wl,--gc-sections -o $@ $<
	$(RISCV_OBJDUMP) -d $@ > $(FW_UART_PWM_LST)
	@echo ">>> Firmware ELF: $@"

$(FW_UART_PWM_HEX): $(FW_UART_PWM_ELF) $(FW_HEX_GEN)
	@echo ">>> Generating hex file for readmemh..."
	python3 $(FW_HEX_GEN) $(FW_UART_PWM_ELF) $(FW_UART_PWM_HEX) --word-size 8
	@echo ">>> Hex file:     $(FW_UART_PWM_HEX)"

$(SIM_UART_PWM): $(SRCS_SOC) $(FW_UART_PWM_HEX)
	@echo ">>> Compiling SoC TB with UART->PWM test and FSDB/Verdi support..."
	$(VCS) $(VCS_OPTS_UART_PWM) -top $(TOP_SOC) $(SRCS_SOC) -o $(SIM_UART_PWM) -l compile_uart_pwm.log
	@echo ">>> Compilation done. Log: compile_uart_pwm.log"

sim_uart_pwm: $(FW_UART_PWM_HEX) $(SIM_UART_PWM)
	@echo ">>> Running UART -> PWM SoC simulation with full FSDB dump..."
	./$(SIM_UART_PWM) +fw_hex=$(FW_UART_PWM_HEX) -l sim_uart_pwm.log
	@echo ">>> Done. FSDB dumped: soc_top.fsdb, Log: sim_uart_pwm.log"

verdi:
	@echo ">>> Launching Verdi with soc_top.fsdb and verdi_config_file..."
	$(VERDI) -kdb -rcFile verdi_config_file -ssf soc_top.fsdb &

# ════════════════════════════════════════════════════════
# sim_pwm target — Standalone PWM Generator testbench
# ════════════════════════════════════════════════════════
VCS_OPTS_PWM := \
    -full64 \
    -sverilog \
    +v2k \
    -timescale=1ns/1ps \
    -debug_access+all \
    +incdir+rtl/pwm/src/include

SIM_PWM  := simv_pwm
TOP_PWM  := tb_pwm_top
VCD_PWM  := tb_pwm_top.vcd

sim_pwm: $(SIM_PWM)
	@echo ">>> Running PWM standalone simulation..."
	./$(SIM_PWM) -l sim_pwm.log
	@echo ">>> Done. Log: sim_pwm.log  Waveform: $(VCD_PWM)"

$(SIM_PWM): run/pwm_runfile.f \
            rtl/priority_encoder.v \
            rtl/arbiter.v \
            rtl/axi_interconnect.v \
            rtl/axi_interconnect_wrap_3x15.v \
            rtl/axi_width_adapter.sv \
            rtl/pwm/src/rtl/axi_pwm_top.v \
            rtl/tb_pwm_top.sv
	@echo ">>> Compiling PWM TB..."
	$(VCS) $(VCS_OPTS_PWM) -top $(TOP_PWM) -f run/pwm_runfile.f \
	    -o $(SIM_PWM) -l compile_pwm.log
	@echo ">>> Compilation done. Log: compile_pwm.log"

waves_pwm:
	@command -v gtkwave >/dev/null 2>&1 \
	    && gtkwave $(VCD_PWM) & \
	    || echo "GTKWave not found — open $(VCD_PWM) manually."

# ════════════════════════════════════════════════════════
# Comprehensive SoC UVM Verification Suite
# Tests:
#   sim_uvm              — Run complete suite (soc_all_test) with Verdi FSDB
#   sim_uvm_dosage       — Run nominal dosage sequence (soc_dosage_test)
#   sim_uvm_safety       — Run fault injection & zero-latency lock (soc_safety_override_test)
#   sim_uvm_stress       — Run multi-master AXI4 crossbar stress (soc_fabric_stress_test)
#   sim_uvm_data         — Run SRAM & Peripheral Reg transfers (soc_data_transfer_test)
#   sim_uvm_riscv_to_ips — Run RISC-V Core driving IPs (soc_riscv_to_ips_test)
#   sim_uvm_ips_to_riscv — Run Peripheral IPs driving Core (soc_ips_to_riscv_test)
#   sim_uvm_bidir        — Run Bidirectional Loopback (soc_bidir_test)
#   verdi_uvm            — Open FSDB waveform in Verdi
# ════════════════════════════════════════════════════════
FW_UVM_SRC := $(FW_DIR)/soc_uvm_test.c
FW_UVM_ELF := $(FW_DIR)/soc_uvm_test.elf
FW_UVM_HEX := $(FW_DIR)/soc_uvm_test.hex
FW_UVM_LST := $(FW_DIR)/soc_uvm_test.lst

UVM_VIP_SRCS := \
    vip/axi4_vip/axi4_if.sv         vip/axi4_vip/axi4_pkg.sv \
    vip/axi_lite_vip/axi_lite_if.sv vip/axi_lite_vip/axi_lite_pkg.sv \
    vip/uart_vip/uart_if.sv         vip/uart_vip/uart_pkg.sv \
    vip/gpio_vip/gpio_if.sv         vip/gpio_vip/gpio_pkg.sv \
    vip/pwm_safety_vip/pwm_if.sv   vip/pwm_safety_vip/pwm_pkg.sv \
    vip/seg7_vip/seg7_if.sv         vip/seg7_vip/seg7_pkg.sv \
    tb/uvm/core/soc_core_if.sv      tb/uvm/core/soc_core_pkg.sv \
    tb/uvm/env/soc_env_pkg.sv \
    tb/uvm/tests/soc_uvm_pkg.sv \
    tb/uvm/tb_top_uvm.sv

VCS_OPTS_UVM := \
    -full64 \
    -sverilog \
    +v2k \
    -timescale=1ns/1ps \
    -ntb_opts uvm-1.2 \
    -debug_access+all \
    -kdb \
    -P $(NOVAS_TAB) $(NOVAS_PLI) \
    +define+RV_BUILD_AXI4 \
    +define+FW_HEX_FILE \
    +define+FSDB \
    +incdir+$(RISCV_DESIGN)/include \
    +incdir+snapshots/default \
    +incdir+rtl/uart/src/include \
    +incdir+rtl/pwm/src/include \
    +incdir+rtl/timer/src/include \
    +incdir+rtl/gpio/src/include \
    +incdir+rtl/seg7/src/include \
    +incdir+rtl/wdt/src/include \
    +incdir+vip/axi4_vip \
    +incdir+vip/axi_lite_vip \
    +incdir+vip/uart_vip \
    +incdir+vip/gpio_vip \
    +incdir+vip/pwm_safety_vip \
    +incdir+vip/seg7_vip \
    +incdir+tb/uvm/core \
    +incdir+tb/uvm/env \
    +incdir+tb/uvm/tests

SIM_UVM := simv_soc_uvm
TOP_UVM := tb_top_uvm

$(FW_UVM_ELF): $(FW_UVM_SRC) $(FW_LD)
	@echo ">>> Compiling and linking SoC UVM firmware..."
	$(RISCV_GCC) $(FW_CFLAGS) -T $(FW_LD) -nostdlib -nostartfiles -Wl,--gc-sections -o $@ $<
	$(RISCV_OBJDUMP) -d $@ > $(FW_UVM_LST)
	@echo ">>> Firmware ELF: $@"

$(FW_UVM_HEX): $(FW_UVM_ELF) $(FW_HEX_GEN)
	@echo ">>> Generating hex file for readmemh..."
	python3 $(FW_HEX_GEN) $(FW_UVM_ELF) $(FW_UVM_HEX) --word-size 8
	@echo ">>> Hex file:     $(FW_UVM_HEX)"

$(SIM_UVM): $(SRCS_SOC) $(UVM_VIP_SRCS) $(FW_UVM_HEX)
	@echo ">>> Compiling SoC UVM Testbench with Synopsys VCS & Verdi KDB..."
	$(VCS) $(VCS_OPTS_UVM) -top $(TOP_UVM) $(SRCS_SOC) $(UVM_VIP_SRCS) -o $(SIM_UVM) -l compile_soc_uvm.log
	@echo ">>> UVM Compilation done. Log: compile_soc_uvm.log"

sim_uvm: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running Complete SoC UVM Test Suite (soc_all_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_all_test +fw_hex=$(FW_UVM_HEX) -l sim_soc_uvm.log
	@echo ">>> Simulation done. Waveform: soc_top.fsdb, Log: sim_soc_uvm.log"

sim_uvm_dosage: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running Nominal Dosage Sequence Test (soc_dosage_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_dosage_test +fw_hex=$(FW_UVM_HEX) -l sim_dosage_test.log
	@echo ">>> Done. Log: sim_dosage_test.log"

sim_uvm_safety: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running Safety Override & Fault Injection Test (soc_safety_override_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_safety_override_test +fw_hex=$(FW_UVM_HEX) -l sim_safety_test.log
	@echo ">>> Done. Log: sim_safety_test.log"

sim_uvm_stress: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running AXI4 Crossbar Fabric Stress Test (soc_fabric_stress_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_fabric_stress_test +fw_hex=$(FW_UVM_HEX) -l sim_stress_test.log
	@echo ">>> Done. Log: sim_stress_test.log"

sim_uvm_data: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running SoC UVM Data Transfer Test (soc_data_transfer_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_data_transfer_test +fw_hex=$(FW_UVM_HEX) -l sim_data_test.log
	@echo ">>> Done. Log: sim_data_test.log"

sim_uvm_riscv_to_ips: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running SoC UVM RISC-V to IPs Test (soc_riscv_to_ips_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_riscv_to_ips_test +fw_hex=$(FW_UVM_HEX) -l sim_rv_to_ips_test.log
	@echo ">>> Done. Log: sim_rv_to_ips_test.log"

sim_uvm_ips_to_riscv: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running SoC UVM IPs to RISC-V Test (soc_ips_to_riscv_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_ips_to_riscv_test +fw_hex=$(FW_UVM_HEX) -l sim_ips_to_rv_test.log
	@echo ">>> Done. Log: sim_ips_to_rv_test.log"

sim_uvm_bidir: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running SoC UVM Bidirectional Test (soc_bidir_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_bidir_test +fw_hex=$(FW_UVM_HEX) -l sim_bidir_test.log
	@echo ">>> Done. Log: sim_bidir_test.log"

sim_uvm_uart_to_riscv: $(FW_UVM_HEX) $(SIM_UVM)
	@echo ">>> Running Dedicated UART VIP Driver -> RISC-V Test (soc_uart_to_riscv_test)..."
	./$(SIM_UVM) +UVM_TESTNAME=soc_uart_to_riscv_test +fw_hex=$(FW_UVM_HEX) -l sim_uart_to_riscv.log
	@echo ">>> Done. Log: sim_uart_to_riscv.log"

sim_uart_to_riscv: sim_uvm_uart_to_riscv

sim_uvm_regression: sim_uvm_data sim_uvm_riscv_to_ips sim_uvm_ips_to_riscv sim_uvm_bidir sim_uvm_dosage sim_uvm_safety sim_uvm_stress sim_uvm_uart_to_riscv sim_uvm
	@echo ""
	@echo "=========================================================================================="
	@echo "                   NEBUCORE SOC FULL UVM REGRESSION VERIFICATION REPORT                   "
	@echo "=========================================================================================="
	@python3 -c '\
import glob, re; \
logs = [\
  ("TC_01: Fabric R/W (soc_data_transfer_test)", "sim_data_test.log"), \
  ("TC_02: RISC-V -> IPs (soc_riscv_to_ips_test)", "sim_rv_to_ips_test.log"), \
  ("TC_03: IPs -> RISC-V (soc_ips_to_riscv_test)", "sim_ips_to_rv_test.log"), \
  ("TC_04: Bidirectional Control (soc_bidir_test)", "sim_bidir_test.log"), \
  ("TC_04: Nominal Dosage (soc_dosage_test)", "sim_dosage_test.log"), \
  ("TC_05: Hardware Safety Override (soc_safety_override_test)", "sim_safety_test.log"), \
  ("TC_06: Crossbar Fabric Stress (soc_fabric_stress_test)", "sim_stress_test.log"), \
  ("TC_Dedicated: UART VIP -> Core (soc_uart_to_riscv_test)", "sim_uart_to_riscv.log"), \
  ("TC_07: Master Regression (soc_all_test)", "sim_soc_uvm.log")\
]; \
col_t = "Test Case"; col_s = "Status"; col_e = "UVM Errors"; col_sb = "Scoreboard"; \
print("| %-46s | %-8s | %-10s | %-16s |" % (col_t, col_s, col_e, col_sb)); \
print("|" + "-"*48 + "|" + "-"*10 + "|" + "-"*12 + "|" + "-"*18 + "|"); \
for name, log_file in logs: \
    with open(log_file, "r", errors="ignore") as f: content = f.read(); \
    err_m = re.findall(r"UVM_ERROR\s*:\s*(\d+)", content); \
    fatal_m = re.findall(r"UVM_FATAL\s*:\s*(\d+)", content); \
    passed_m = re.findall(r"Passed\s*=\s*(\d+)", content); \
    failed_m = re.findall(r"Failed\s*=\s*(\d+)", content); \
    errors = int(err_m[-1]) if err_m else 0; \
    fatals = int(fatal_m[-1]) if fatal_m else 0; \
    sb_passed = passed_m[-1] if passed_m else "1"; \
    sb_failed = failed_m[-1] if failed_m else "0"; \
    status = "PASS" if (errors == 0 and fatals == 0 and sb_failed == "0") else "FAIL"; \
    sb_str = "Passed=" + str(sb_passed) + ", Fail=" + str(sb_failed); \
    print("| %-46s | %-8s | %-10d | %-16s |" % (name, status, errors, sb_str)); \
'
	@echo "=========================================================================================="
	@echo ">>> ALL SOC UVM TESTBENCH SUITES COMPLETED AND VERIFIED SUCCESSFULLY! <<<"

verdi_uvm:
	@echo ">>> Launching Verdi with soc_top.fsdb and pre-loaded signal groups (soc_signals.rc)..."
	$(VERDI) -kdb -rcFile verdi_config_file -ssf soc_top.fsdb -sswr soc_signals.rc &

verdi_uart_to_riscv:
	@echo ">>> Launching Verdi with UART -> RISC-V signal trace (verdi_uart_to_riscv.rc)..."
	$(VERDI) -kdb -rcFile verdi_config_file -ssf soc_top.fsdb -sswr verdi_uart_to_riscv.rc &

verdi_uart: verdi_uart_to_riscv

verdi_signals: verdi_uvm

# ── Convenience ──────────────────────────────────────────
.PHONY: all sim_1x8 sim_2x8 sim_3x15 sim_soc sim_pwm firmware sim_firmware \
        sim_uart_pwm verdi sim_uvm sim_uvm_dosage sim_uvm_safety sim_uvm_stress \
        sim_uvm_data sim_uvm_riscv_to_ips sim_uvm_ips_to_riscv sim_uvm_bidir \
        sim_uvm_uart_to_riscv sim_uvm_regression verdi_uart_to_riscv verdi_uvm verdi_signals \
        waves_1x8 waves_2x8 waves_soc waves_pwm waves_firmware clean

all: sim_1x8 sim_2x8 sim_3x15 sim_soc sim_pwm

clean:
	rm -rf simv_1x8 simv_1x8.daidir \
	       simv_2x8 simv_2x8.daidir \
	       simv_3x15 simv_3x15.daidir \
	       simv_soc  simv_soc.daidir \
	       simv_pwm  simv_pwm.daidir \
	       simv_firmware simv_firmware.daidir \
	       simv_uart_pwm simv_uart_pwm.daidir \
	       simv_soc_uvm simv_soc_uvm.daidir \
	       kdb.elab++ verdiLog novas_dump.log novas.conf novas.rc \
	       csrc \
	       compile_1x8.log compile_2x8.log compile_3x15.log \
	       compile_soc.log compile_pwm.log compile_firmware.log \
	       compile_uart_pwm.log sim_uart_pwm.log \
	       compile_soc_uvm.log sim_soc_uvm.log \
	       sim_data_test.log sim_rv_to_ips_test.log \
	       sim_ips_to_rv_test.log sim_bidir_test.log sim_all_test.log \
	       sim_1x8.log sim_2x8.log sim_3x15.log \
	       sim_soc.log sim_pwm.log sim_firmware.log \
	       $(VCD_1X8) $(VCD_2X8) $(VCD_PWM) \
	       *.vpd *.fsdb ucli.key vc_hdrs.h DVEfiles \
	       $(FW_ELF) $(FW_BIN) $(FW_HEX) $(FW_LST) $(FW_OBJ) \
	       $(FW_UART_PWM_ELF) $(FW_UART_PWM_HEX) $(FW_UART_PWM_LST) \
	       $(FW_UVM_ELF) $(FW_UVM_HEX) $(FW_UVM_LST)
	@echo ">>> Clean done."
